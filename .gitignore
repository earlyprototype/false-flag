# Configuration (contains API keys)
config.py
.env

# Saves
saves/
*.json

# The shared-key blob for the browser build is NOT given an ignore rule of its
# own: it is ciphertext, it is meant to be published, and it is the owner's
# deliberate decision to publish it. It is caught by the blanket *.json above,
# which is the behaviour we want — you have to ask for it by name:
#   git add -f docs/play/shared-key.json
# The worked example beside it is committed so the format is documented even
# on forks that ship no key of their own.
!docs/play/shared-key.example.json

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.bak

# Cursor IDE
.cursor/

# Node
node_modules/

# Next.js build output
.next/

# Generated test images
*.png

# Large compiled scene files
compiled_*.json
*_scene.json

# Test output
test_output.txt

# User approvals
user_approval*.txt


# Claude Code session tooling (worktrees, local settings)
.claude/

# Browser build: the Pyodide runtime (~16.5 MB) is fetched, not committed.
#   python3 dev-scripts/fetch_pyodide.py
# worker.js prefers this local copy when present and falls back to jsDelivr.
# To ship a self-hosted, zero-external-request build, force-add it:
#   git add -f docs/play/pyodide
docs/play/pyodide/

# Playwright verification output
dev-scripts/play-verify/
